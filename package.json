{
  "name": "settlebot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "build": "node scripts/check-compatibility.mjs && wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --env local",
    "db:migrate:local": "wrangler d1 migrations apply LEDGER_DB --local --env local",
    "export:ledger": "node scripts/export-ledger.mjs",
    "test:delivery": "node --test tests/delivery.test.mjs",
    "test:release": "node --test tests/release-worker.test.mjs",
    "build:test-worker": "cargo install -q \"worker-build@0.8.7\" --locked && worker-build --release --out-dir build/d1-test --locked --features d1-test",
    "test:recovery": "pnpm build:test-worker && node --test tests/sql-recovery.test.mjs",
    "test:d1": "pnpm build:test-worker && node --test tests/d1.test.mjs tests/telegram.test.mjs tests/reporting.test.mjs tests/report-capacity.test.mjs tests/audit-recovery.test.mjs tests/audit-ordering.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.150.0"
  }
}
